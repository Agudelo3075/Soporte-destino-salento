# AWS S3 Configuración para Destino Salento
# Reemplaza los valores de ejemplo con tus credenciales reales de AWS

VITE_AWS_REGION=us-east-1
VITE_AWS_ACCESS_KEY_ID=TU_ACCESS_KEY_ID_AQUI
VITE_AWS_SECRET_ACCESS_KEY=TU_SECRET_ACCESS_KEY_AQUI
VITE_AWS_BUCKET_NAME=destino-salento-bucket

# Opcional: Dominio personalizado o CloudFront para las imágenes de Salento (ej: https://cdn.destinosalento.com)
VITE_AWS_S3_CUSTOM_DOMAIN=
